<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <Version>0.2.0-alpha.2</Version>
    <!-- Uno 6.7's managed and native Skia dependencies must share one ABI version. -->
    <VectorSpaceSkiaVersion>3.119.2</VectorSpaceSkiaVersion>
    <SkiaSharpVersion>$(VectorSpaceSkiaVersion)</SkiaSharpVersion>
    <Authors>Wiesław Šoltés; VectorSpace contributors</Authors>
    <Company>VectorSpace</Company>
    <Copyright>Copyright © 2026 VectorSpace contributors</Copyright>
    <RepositoryUrl>https://github.com/wieslawsoltes/VectorSpace</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/wieslawsoltes/VectorSpace</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
