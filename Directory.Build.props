<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <Version>0.8.0-alpha.1</Version>
    <!-- Uno 6.7's managed and native Skia dependencies must share one ABI version. -->
    <VectorSpaceSkiaVersion>3.119.2</VectorSpaceSkiaVersion>
    <SkiaSharpVersion>$(VectorSpaceSkiaVersion)</SkiaSharpVersion>
    <Authors>Wiesław Šoltés</Authors>
    <Company>Wiesław Šoltés</Company>
    <Copyright>Copyright © 2026 Wiesław Šoltés</Copyright>
    <RepositoryUrl>https://github.com/wieslawsoltes/VectorSpace</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://wieslawsoltes.github.io/UnoSpace/projects/vectorspace/</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>vectorspace;vector;design;graphics;svg;prototyping;collaboration;uno-platform;skiasharp;webassembly;desktop</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)build/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
