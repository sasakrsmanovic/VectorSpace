<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="'$(VectorSpaceDesktopOnly)' == 'true'">net10.0-desktop</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <UnoFeatures>SkiaRenderer;</UnoFeatures>
    <ApplicationTitle>VectorSpace</ApplicationTitle>
    <ApplicationId>io.github.wieslawsoltes.vectorspace</ApplicationId>
    <ApplicationDisplayVersion>0.8.0</ApplicationDisplayVersion>
    <ApplicationVersion>8</ApplicationVersion>
    <ApplicationPublisher>VectorSpace contributors</ApplicationPublisher>
    <Description>Local-first vector design with Uno Platform and SkiaSharp.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <UnoDisableHotDesign>true</UnoDisableHotDesign>
    <UnoDisableMCPSupport>true</UnoDisableMCPSupport>
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmShellGenerateAOTProfile>false</WasmShellGenerateAOTProfile>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../VectorSpace.Workbench/VectorSpace.Workbench.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browserwasm'">
    <EmbeddedResource Include="Platforms/WebAssembly/WasmScripts/Storage.js" />
    <EmbeddedResource Include="Platforms/WebAssembly/WasmScripts/Collaboration.js" />
  </ItemGroup>
</Project>
